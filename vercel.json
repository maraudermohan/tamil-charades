{
  "redirects": [
    {
      "source": "/game/:slug",
      "destination": "/game/:slug/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_next/static/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
