Options -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Canonical origin in one 301: HTTPS + host www.tamilcharades.com
#    (Your deployed rule used %{https} off; Apache expects %{HTTPS} off. Wrong variable can break HTTPS detection.)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.tamilcharades\.com$ [NC]
RewriteRule ^ https://www.tamilcharades.com%{REQUEST_URI} [L,R=301]

# 2) Next static export (trailingSlash): real files are game/<slug>/index.html
RewriteRule ^game/(classic|story|song|kids|hollywood)$ https://www.tamilcharades.com/game/$1/ [R=301,L]

# 3) Extensionless URLs: /page -> page.html when that file exists (internal rewrite, not redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ %{REQUEST_FILENAME}.html [L]
</IfModule>

# Same-host 404 keeps HTTP status 404 for crawlers (full URL ErrorDocument can look like a soft 404)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
SetEnvIf Request_URI "^/_next/static/" NEXT_STATIC_IMMUTABLE
Header set Cache-Control "public, max-age=31536000, immutable" env=NEXT_STATIC_IMMUTABLE
</IfModule>

<Files "dbconnection.php">
  Order allow,deny
  Deny from all
</Files>
