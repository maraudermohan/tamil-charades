Options -MultiViews

<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# 1) Canonical origin in one 301: HTTPS + host www.tamilcharades.com
#    (Your deployed rule used %{https} off; Apache expects %{HTTPS} off. Wrong variable can break HTTPS detection.)
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^www\.tamilcharades\.com$ [NC]
RewriteRule ^ https://www.tamilcharades.com%{REQUEST_URI} [L,R=301]

# 2) Next static export (trailingSlash): real files are game/<slug>/index.html
RewriteRule ^game/(classic|story|song|kids|hollywood)$ https://www.tamilcharades.com/game/$1/ [R=301,L]

# 3) Extensionless URLs: /page -> page.html when that file exists (internal rewrite, not redirect)
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.*)$ %{REQUEST_FILENAME}.html [L]
</IfModule>

# Same-host 404 keeps HTTP status 404 for crawlers (full URL ErrorDocument can look like a soft 404)
ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Immutable fingerprinted assets — safe to cache for 1 year
  <FilesMatch "\.(js|mjs|css|woff|woff2|ttf|eot|otf|webp|png|jpg|jpeg|gif|ico|svg|map)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HTML pages — short cache so deploys propagate
  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType font/woff2                   "access plus 1 year"
  ExpiresByType font/woff                    "access plus 1 year"
  ExpiresByType image/webp                   "access plus 1 year"
  ExpiresByType application/javascript       "access plus 1 year"
  ExpiresByType text/css                     "access plus 1 year"
  ExpiresByType text/html                    "access plus 1 hour"
</IfModule>

<Files "dbconnection.php">
  Order allow,deny
  Deny from all
</Files>
