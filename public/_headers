# Netlify: long cache for fingerprinted Next assets (Lighthouse cache TTL).
/_next/static/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/css/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/media/*
  Cache-Control: public, max-age=31536000, immutable

/_next/static/chunks/*
  Cache-Control: public, max-age=31536000, immutable
